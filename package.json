{
  "name": "kmerhosting-domain-portal",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:styles": "node scripts/check-carbon-style-contract.mjs",
    "audit:shell": "node scripts/audit-shell-layout.mjs",
    "audit:auth": "node scripts/audit-domain-session-gateway.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run check:styles && npm run audit:shell && npm run audit:auth && vite build",
    "build:strict": "npm run check:styles && npm run audit:shell && npm run audit:auth && tsc -p tsconfig.app.json --pretty false && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --pretty false",
    "check": "npm test && npm run check:styles && npm run audit:shell && npm run audit:auth && npm run typecheck && vite build"
  },
  "dependencies": {
    "@carbon/react": "^1.114.0",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.126.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.8",
    "@vitejs/plugin-react": "^4.7.0",
    "sass": "^1.93.2",
    "typescript": "^5.8.3",
    "vite": "^7.0.6"
  }
}
